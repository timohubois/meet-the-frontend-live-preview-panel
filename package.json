{
  "name": "meet-the-frontend-live-preview-panel",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wp-scripts build src/classic-editor.js src/block-editor.js src/term-editor.js src/revision-browser.js src/preview-navigation.js",
    "start": "wp-scripts start src/classic-editor.js src/block-editor.js src/term-editor.js src/revision-browser.js src/preview-navigation.js",
    "test": "node --test tests/*.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js src --max-warnings=0",
    "lint:css": "wp-scripts lint-style src/panel/panel.css --max-warnings=0",
    "format:css": "prettier --write --tab-width 4 --no-use-tabs src/panel/panel.css"
  },
  "dependencies": {
    "@wordpress/api-fetch": "8.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/data": "11.1.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/hooks": "5.1.0",
    "@wordpress/icons": "20.0.0",
    "@wordpress/notices": "6.1.0",
    "@wordpress/preferences": "5.1.0"
  },
  "devDependencies": {
    "@wordpress/scripts": "37.1.0"
  },
  "cssnano": {
    "preset": [
      "default",
      {
        "discardComments": {
          "removeAll": false
        }
      }
    ]
  }
}
